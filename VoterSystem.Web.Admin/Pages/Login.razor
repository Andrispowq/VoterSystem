@page "/login"
@using System.Net.Http.Json
@using System.Text.Json
@using VoterSystem.Shared.Blazor
@using VoterSystem.Shared.Blazor.Config
@using VoterSystem.Shared.Blazor.Services
@using VoterSystem.Shared.Blazor.ViewModels
@using VoterSystem.Shared.Dto
@using VoterSystem.Web.Admin.Layout
@inject NavigationManager NavigationManager
@inject IAuthenticationService AuthenticationService
@inject HttpClient HttpClient
@inject AppConfig AppConfig
@inject JsonSerializerOptions JsonOptions

<div class="my-4 container">

    <h1>Login</h1>

    <MessageComponent Condition="@Offline"
                      ConditionText="Offline mode"
                      AlertMessage="Switch to online mode to log in." />

    @if (!Offline)
    {
        @if (_tryAutoLogin)
        {
            <p>Try autologin...</p>
        }
        else
        {
            @if (AppConfig.EnableTestUsers)
            {
                <div class="mb-3">
                    @for (var i = 1; i <= 6; ++i)
                    {
                        var i2 = i;
                        <button type="button"
                                class="btn btn-outline-secondary me-2"
                                @onclick="() => LoginAsUser(i2)">
                            Login as user @i
                        </button>
                    }
                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="LoginAsAdmin">
                        Login as admin
                    </button>
                </div>
            }

            @if (_pendingTwoFactorUserId is null)
            {
                <EditForm Model="LoginViewModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label" for="email">Email:</label>
                        <InputText class="form-control form-control" id="email" @bind-Value="LoginViewModel.Email" />
                        <ValidationMessage For="@(() => LoginViewModel.Email)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="password">Password:</label>
                        <InputText class="form-control form-control" id="password" @bind-Value="LoginViewModel.Password" type="password" />
                        <ValidationMessage For="@(() => LoginViewModel.Password)" class="text-danger" />
                    </div>

                    <div class="d-flex justify-content-between">
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Login
                        </button>

                        <button class="btn btn-link text-muted" type="button" @onclick="ForgotPassword">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Forgot Password?
                        </button>

                        <button class="btn btn-outline-primary" type="button" @onclick="Register">
                            <i class="bi bi-person-plus me-1"></i> Register
                        </button>
                    </div>
                </EditForm>

                <div class="mt-4">
                    <p class="text-muted mb-2">Or continue with</p>

                    <button type="button"
                            class="btn btn-outline-danger me-2"
                            disabled="@(!IsExternalLoginSupported(ExternalLoginProvider.Google))"
                            @onclick="() => StartExternalLogin(ExternalLoginProvider.Google)">
                        <i class="bi bi-google me-1"></i> Login with Google
                    </button>

                    <button type="button"
                            class="btn btn-outline-primary"
                            disabled="@(!IsExternalLoginSupported(ExternalLoginProvider.Facebook))"
                            @onclick="() => StartExternalLogin(ExternalLoginProvider.Facebook)">
                        <i class="bi bi-facebook me-1"></i> Login with Facebook
                    </button>

                    <button type="button"
                            class="btn btn-outline-dark mt-2 mt-sm-0 ms-sm-2"
                            disabled="@(!IsExternalLoginSupported(ExternalLoginProvider.Saml))"
                            @onclick="() => StartExternalLogin(ExternalLoginProvider.Saml)">
                        <i class="bi bi-shield-lock me-1"></i> Login with SAML
                    </button>
                </div>
            }
            else
            {
                <EditForm Model="LoginViewModel" OnValidSubmit="HandleTwoFactorLogin">
                    <DataAnnotationsValidator />

                    <p class="text-muted">A 6 digit verification code has been sent to your email address.</p>

                    <div class="mb-3">
                        <label class="form-label" for="two-factor-code">Two-factor code:</label>
                        <InputText class="form-control form-control" id="two-factor-code" @bind-Value="LoginViewModel.TwoFactorCode" />
                        <ValidationMessage For="@(() => LoginViewModel.TwoFactorCode)" class="text-danger" />
                    </div>

                    <div class="d-flex justify-content-between">
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-shield-check me-1"></i> Verify code
                        </button>

                        <button class="btn btn-outline-secondary" type="button" @onclick="CancelTwoFactorLogin">
                            Back
                        </button>
                    </div>
                </EditForm>
            }
        }
    }
</div>


@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public bool Offline { get; set; }

    private LoginViewModel LoginViewModel { get; set; } = new();
    private bool _tryAutoLogin = true;
    private Guid? _pendingTwoFactorUserId;
    private readonly HashSet<ExternalLoginProvider> _supportedExternalLoginProviders = [];
    
    protected override async Task OnInitializedAsync()
    {
        if (Offline)
        {
            StateHasChanged();
            return;
        }
        
        var success = await AuthenticationService.TryAutoLoginAsync();
        if (success)
        {
            NavigationManager.NavigateTo("/votings");
        }
        else
        {
            _tryAutoLogin = false;
            await LoadSupportedExternalLoginModesAsync();
        }
    }

    private async Task LoadSupportedExternalLoginModesAsync()
    {
        try
        {
            var modes = await HttpClient.GetFromJsonAsync<List<ExternalLoginProvider>>(
                "api/v1/users/supported-external-login-modes",
                JsonOptions);

            if (modes is null)
            {
                return;
            }

            foreach (var mode in modes)
            {
                _supportedExternalLoginProviders.Add(mode);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load supported external login modes: {ex.Message}");
        }
    }

    private async Task HandleLogin()
    {
        var result = await AuthenticationService.LoginAsync(LoginViewModel);
        if (result.Succeeded)
        {
            NavigationManager.NavigateTo("/votings");
        }
        else if (result.RequiresTwoFactor)
        {
            _pendingTwoFactorUserId = result.UserId;
            LoginViewModel.TwoFactorCode = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleTwoFactorLogin()
    {
        if (_pendingTwoFactorUserId is null)
        {
            return;
        }

        var success = await AuthenticationService.CompleteTwoFactorLoginAsync(
            _pendingTwoFactorUserId.Value,
            LoginViewModel.TwoFactorCode ?? string.Empty);
        if (success)
        {
            NavigationManager.NavigateTo("/votings");
        }
    }

    private Task CancelTwoFactorLogin()
    {
        _pendingTwoFactorUserId = null;
        LoginViewModel.TwoFactorCode = null;
        return Task.CompletedTask;
    }
    
    private async Task LoginAsUser(int number)
    {
        LoginViewModel.Email = DevLogins.DevUserEmail(number);
        LoginViewModel.Password = DevLogins.DevUserPassword;
        await HandleLogin();
    }

    private async Task LoginAsAdmin()
    {
        LoginViewModel.Email = DevLogins.DevAdminEmail;
        LoginViewModel.Password = DevLogins.DevAdminPassword;
        await HandleLogin();
    }

    private async Task Register()
    {
        NavigationManager.NavigateTo("/register");
        await Task.CompletedTask;
    }

    private async Task ForgotPassword()
    {
        NavigationManager.NavigateTo("/forgot-password");
        await Task.CompletedTask;
    }

    private void StartExternalLogin(ExternalLoginProvider provider)
    {
        if (!IsExternalLoginSupported(provider))
        {
            return;
        }

        var baseAddress = HttpClient.BaseAddress?.ToString().TrimEnd('/');
        if (string.IsNullOrEmpty(baseAddress))
        {
            return;
        }

        var url = $"{baseAddress}/api/v1/users/external-login/{provider}?frontend=admin";
        NavigationManager.NavigateTo(url, true);
    }

    private bool IsExternalLoginSupported(ExternalLoginProvider provider) =>
        _supportedExternalLoginProviders.Contains(provider);
}
