@page "/login"
@using VoterSystem.DataAccess.Model
@using VoterSystem.Shared.Blazor
@using VoterSystem.Shared.Blazor.Config
@using VoterSystem.Shared.Blazor.Services
@using VoterSystem.Shared.Blazor.ViewModels
@using VoterSystem.Web.Layout
@inject NavigationManager NavigationManager
@inject IAuthenticationService AuthenticationService

<div class="my-4 container">

    <h1>Login</h1>

    <MessageComponent Condition="@Offline"
                      ConditionText="Offline mode"
                      AlertMessage="Switch to online mode to log in." />

    <CustomAlertModal Title="This site is only for non-admin users."
                      Body="You are an Admin, which means that you may only access the Admin site. The Ok button will take you there, where you can log in."
                      OnOk="NavigateToAdmin"
                      @ref="_adminLoginModal" />

    @if (!Offline)
    {
        @if (_tryAutoLogin)
        {
            <p>Try autologin...</p>
        }
        else
        {
            <div class="mb-3">
                @for (var i = 1; i <= 6; ++i)
                {
                    var i2 = i;
                    <button type="button"
                            class="btn btn-outline-secondary me-2"
                            @onclick="() => LoginAsUser(i2)">
                        Login as user @i
                    </button>
                }
                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="LoginAsAdmin">
                    Login as admin
                </button>
            </div>
            
            <EditForm Model="LoginViewModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="email">Email:</label>
                    <InputText class="form-control form-control" id="email" @bind-Value="LoginViewModel.Email" />
                    <ValidationMessage For="@(() => LoginViewModel.Email)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="password">Password:</label>
                    <InputText class="form-control form-control" id="password" @bind-Value="LoginViewModel.Password" type="password" />
                    <ValidationMessage For="@(() => LoginViewModel.Password)" class="text-danger" />
                </div>

                <button class="btn btn-primary" type="submit">Login</button>
            </EditForm>
        }
    }
</div>


@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public bool Offline { get; set; }

    private CustomAlertModal? _adminLoginModal;

    private LoginViewModel LoginViewModel { get; set; } = new();
    private bool _tryAutoLogin = true;

    protected override async Task OnInitializedAsync()
    {
        if (Offline)
        {
            StateHasChanged();
            return;
        }
        
        var success = await AuthenticationService.TryAutoLoginAsync();
        if (success)
        {
            await GoToHome();
        }
        else
        {
            _tryAutoLogin = false;
        }
    }

    private async Task HandleLogin()
    {
        var success = await AuthenticationService.LoginAsync(LoginViewModel);
        if (success)
        {
            await GoToHome();
        }
    }

    private async Task GoToHome()
    {
        var role = await AuthenticationService.GetCurrentRoleAsync();
        if (role != Role.User)
        {
            _adminLoginModal?.Show();   
            return;
        }
            
        NavigationManager.NavigateTo("/home");
    }

    private Task NavigateToAdmin()
    {
        NavigationManager.NavigateTo($"{RedirectUrls.AdminBaseUrl}/login");
        return Task.CompletedTask;
    }
    
    private async Task LoginAsUser(int number)
    {
        LoginViewModel.Email = DevLogins.DevUserEmail(number);
        LoginViewModel.Password = DevLogins.DevUserPassword;
        await HandleLogin();
    }

    private async Task LoginAsAdmin()
    {
        LoginViewModel.Email = DevLogins.DevAdminEmail;
        LoginViewModel.Password = DevLogins.DevAdminPassword;
        await HandleLogin();
    }
}