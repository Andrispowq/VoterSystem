{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BlazorUrls": 
  [
    "${WEB_HTTP}",
    "${WEB_HTTPS}",
    "${ADMIN_HTTP}",
    "${ADMIN_HTTPS}"
  ],
  "JwtSettings": {
    "SecretKey": "${JWT_KEY}",
    "Audience": "${JWT_DOMAIN}",
    "Issuer": "${JWT_DOMAIN}",
    "AccessTokenExpirationMinutes": 30
  },
  "ConnectionStrings": {
    "VoterSystemConnection": "Host=localhost;Port=5432;Database=VoterSystem;Username=${DB_USER};Password=${DB_PASSWORD}",
    "Redis": "localhost:6379"
  },
  "BlazorSettings": {
    "AdminPageUrl": "${ADMIN_HTTPS}"
  },
  "VotingSettings": {
    "MasterKey": "${VOTING_MASTER_KEY}"
  },
  "EmailSettings": {
    "Host": "${EMAIL_HOST}",
    "Port": "${EMAIL_PORT}",
    "EnableSsl": "${EMAIL_SSL}",
    "UserName": "${EMAIL_USER}",
    "Password": "${EMAIL_PASSWORD}",
    "FromEmail": "${EMAIL_FROM}"
  }
}
